# Optional environment overrides (UI Settings also work)
# Never commit real keys.

# OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, etc.)
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_CHEAP_MODEL=gpt-4o-mini
JARVIS_LLM_STANDARD_MODEL=gpt-4o-mini
JARVIS_LLM_STRONG_MODEL=gpt-4o
JARVIS_LLM_STRONGEST_MODEL=gpt-4o

# Anthropic (optional)
JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Fish Audio TTS (optional)
JARVIS_FISH_API_KEY=
JARVIS_FISH_REFERENCE_ID=

# Assistant
JARVIS_WAKE_PHRASE=jarvis
JARVIS_USER_ADDRESS=sir
